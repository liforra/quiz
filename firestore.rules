rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Match against the structure defined in src/app.tsx
    // db.collection('artifacts', appId, ...)
    match /artifacts/{appId} {
      
      // 1. User Private Data
      // Path: artifacts/{appId}/users/{uid}/...
      // Logic: Users can read/write ONLY their own data.
      // Admin Override: liforra can read everyone's data.
      match /users/{userId}/{document=**} {
        allow read, write: if isOwner(userId);
        allow read: if isSignedIn() && request.auth.token.email == 'liforra@quiz.local';
      }
      
      // 2. Public Data
      // Path: artifacts/{appId}/public/data/quizzes
      // Logic: Any authenticated user can read public quizzes.
      // Any authenticated user can publish (create) a quiz.
      match /public/{document=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }
  }
}
