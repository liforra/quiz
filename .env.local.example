# Copy this file to .env.local (already git-ignored via the `*.local` pattern).
# .env.local holds real secrets and is only read by the backend (server/index.js),
# never bundled into the client — unlike .env, which only holds the public
# Firebase client config.

# Groq API key. Optional: without it the app still works fully, the AI
# features (AI-graded text answers, "?" explanations, the Help? chat) just
# stay disabled and quiz text-input questions fall back to the old
# self-reported reveal flow.
GROQ_API_KEY=

# Groq model to use for all three AI features (grading / explain / help chat).
GROQ_MODEL=openai/gpt-oss-120b

# Port the backend proxy listens on. Must match the `proxy` target in
# vite.config.js if you change it.
PORT=8787

# Comma-separated list of origins allowed to call the backend (CORS).
ALLOWED_ORIGINS=http://localhost:3849,https://quiz.liforra.de

# --- Authentik SSO (the primary login, see server/authentik.js) ---
# Without these the login screen falls back to the legacy username/password
# form only, and nobody is forced to migrate.
#
# In Authentik: create an OAuth2/OpenID *Provider* (authorization code flow,
# client type "confidential", signing key set) plus an Application for it, and
# register these redirect URIs:
#   https://quiz.liforra.de/api/auth/authentik/callback
#   http://localhost:3849/api/auth/authentik/callback   (for local dev)
# The issuer is shown on the provider page as "OpenID Configuration Issuer".
AUTHENTIK_ISSUER=https://auth.liforra.de/application/o/quiz/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_SCOPES=openid profile email

# Public origin of *this* app — the redirect URI is derived from it, so it has
# to match what's registered in Authentik exactly.
PUBLIC_BASE_URL=http://localhost:3849

# Comma-separated Authentik usernames that get admin rights (server-enforced,
# see requireAdmin in server/auth.js).
ADMIN_USERNAMES=liforra

# Where quiz.db lives. Defaults to ./data — make sure this survives redeploys.
DATA_DIR=

# Legacy migration. While this is on, the login screen offers "old account":
# the old password is checked against Firebase's REST API and that account's
# Firestore data is pulled into SQLite (server/migrate.js). It needs the
# VITE_FIREBASE_API_KEY and VITE_FIREBASE_PROJECT_ID from .env.
# Set to 0 once everyone has migrated — then Firebase is out of the picture
# entirely and server/migrate.js can be deleted.
LEGACY_MIGRATION=1
